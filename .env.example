# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
DB_NAME=tradebridge

# Meta WhatsApp Cloud API (developers.facebook.com -> your app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
GRAPH_API_VERSION=v21.0

# Webhook verification — jo bhi random string chaho khud choose karo,
# Meta dashboard me webhook setup karte waqt yahi daalna hai
VERIFY_TOKEN=choose_any_random_string_here

# Admin endpoints ko protect karne ke liye — koi bhi strong random string
ADMIN_TOKEN=change_this_to_a_long_random_string
